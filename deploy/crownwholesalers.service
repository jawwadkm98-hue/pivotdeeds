[Unit]
Description=Crown Wholesalers website
After=network.target

[Service]
Type=simple
User=crown
Group=crown
WorkingDirectory=/var/www/crownwholesalers
Environment=NODE_ENV=production
EnvironmentFile=/etc/crownwholesalers.env
ExecStart=/usr/bin/npm start
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
