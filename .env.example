# Copy to .env.local for local development, or load this file from the server process.
# Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Required. At least 10 characters. This is the /admin password.
ADMIN_PASSWORD=

# Required. At least 24 characters. Signs the admin session cookie.
ADMIN_SESSION_SECRET=

# Optional. Defaults to ./data/pivotdeeds.sqlite
# On a server, use an absolute path outside the git checkout, for example:
# DATABASE_PATH=/var/lib/pivotdeeds/pivotdeeds.sqlite
DATABASE_PATH=

# Optional. Defaults to true when NODE_ENV=production.
# The browser will only store the admin cookie on HTTPS when this is true.
# Set to false only for a short HTTP test before TLS is in place.
# COOKIE_SECURE=true
