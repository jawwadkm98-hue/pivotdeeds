# Local `npm run dev` reads this file. Cloudflare production uses Worker secrets instead.
# Generate a session secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Required. At least 10 characters. This is the /admin password.
ADMIN_PASSWORD=

# Required. At least 24 characters. Signs the admin session cookie.
# Cloudflare secret name: SESSION_SECRET. ADMIN_SESSION_SECRET is still accepted.
SESSION_SECRET=

# Optional local SQLite file used only when the app is not running on Cloudflare.
# Defaults to ./data/crownwholesalers.sqlite
# DATABASE_PATH=

# Optional. Defaults to true when NODE_ENV=production.
# Set to false only for a short HTTP test before TLS is in place.
# COOKIE_SECURE=true
