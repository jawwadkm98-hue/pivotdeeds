{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crownwholesalers",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "crownwholesalers"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crownwholesalers",
      // Replace this placeholder with the id printed by `wrangler d1 create crownwholesalers`.
      "database_id": "3578b4f9-c5f7-43cb-aa68-b184783f9040",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "crownwholesalers-photos"
    }
  ]
}
